{
  "name": "ottodot-trial-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "docker compose exec -T db psql -v ON_ERROR_STOP=1 -U ottodot -d ottodot_trial < db/seed.sql",
    "jobs:expire-holds": "tsx scripts/expire-holds.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "14.2.35",
    "pg": "^8.22.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
