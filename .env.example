# Copy to .env and adjust as needed. Both URLs point at the docker-compose
# Postgres published on host port 5433 (see docker-compose.yml).

# Primary application database.
DATABASE_URL=postgres://ottodot:ottodot@localhost:5433/ottodot_trial

# Database used by the test suite. Kept as a separate URL so tests can target
# an isolated database and never truncate real development data.
TEST_DATABASE_URL=postgres://ottodot:ottodot@localhost:5433/ottodot_trial_test
